<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:DSV.Models"
             xmlns:converters="clr-namespace:DSV.Converters"
             x:Class="DSV.Views.NodeView"
             x:DataType="models:Node"
             Width="{Binding Width}" 
             Height="{Binding Height}">
    
    <UserControl.Resources>
        <converters:HalfConverter x:Key="HalfConverter"/>
    </UserControl.Resources>
    
    <Grid>
        <!-- Rectangle Shape -->
        <Border Name="RectShape"
                Background="{Binding Color}"
                BorderBrush="#FF000088"
                BorderThickness="2"
                CornerRadius="5"
                Padding="8"
                IsVisible="{Binding IsRectangle}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Circle Shape -->
        <Border Name="CircleShape"
                Background="{Binding Color}"
                BorderBrush="#FF000088"
                BorderThickness="2"
                CornerRadius="1000"
                Padding="8"
                IsVisible="{Binding IsCircle}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Triangle Shape (Using Path) -->
        <Grid Name="TriangleShape" IsVisible="{Binding IsTriangle}">
            <Path Fill="{Binding Color}"
                  Stroke="#FF000088"
                  StrokeThickness="2"
                  Stretch="Fill"
                  Data="M 50,0 L 100,100 L 0,100 Z"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Hexagon Shape (Using Path) -->
        <Grid Name="HexagonShape" IsVisible="{Binding IsHexagon}">
            <Path Fill="{Binding Color}"
                  Stroke="#FF000088"
                  StrokeThickness="2"
                  Stretch="Fill"
                  Data="M 25,0 L 75,0 L 100,50 L 75,100 L 25,100 L 0,50 Z"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Selection Border (Rectangle/Circle only for now, or use a generic bounds border) -->
        <Border Name="SelectionBorder"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="3"
                CornerRadius="8"
                Margin="-4"
                IsVisible="{Binding IsSelected}"
                IsHitTestVisible="False"/>

        <!-- Resize Handles (visible when selected) -->
        <Canvas IsVisible="{Binding IsSelected}">
            <!-- Corner resize handles -->
            <Border Name="ResizeTopLeft"
                    Width="8" Height="8"
                    Background="{DynamicResource AccentBrush}"
                    Canvas.Left="-4" Canvas.Top="-4"
                    Cursor="Hand"/>
            
            <Border Name="ResizeTopRight"
                    Width="8" Height="8"
                    Background="{DynamicResource AccentBrush}"
                    Canvas.Right="-4" Canvas.Top="-4"
                    Cursor="Hand"/>
            
            <Border Name="ResizeBottomLeft"
                    Width="8" Height="8"
                    Background="{DynamicResource AccentBrush}"
                    Canvas.Left="-4" Canvas.Bottom="-4"
                    Cursor="Hand"/>
            
            <Border Name="ResizeBottomRight"
                    Width="8" Height="8"
                    Background="{DynamicResource AccentBrush}"
                    Canvas.Right="-4" Canvas.Bottom="-4"
                    Cursor="Hand"/>

            <!-- Edge resize handles -->
            <Border Name="ResizeTop"
                    Height="4"
                    Background="Transparent"
                    Canvas.Left="4" Canvas.Right="4" Canvas.Top="-4"
                    Cursor="SizeNorthSouth"/>
            
            <Border Name="ResizeBottom"
                    Height="4"
                    Background="Transparent"
                    Canvas.Left="4" Canvas.Right="4" Canvas.Bottom="-4"
                    Cursor="SizeNorthSouth"/>

            <Border Name="ResizeLeft"
                    Width="4"
                    Background="Transparent"
                    Canvas.Top="4" Canvas.Bottom="4" Canvas.Left="-4"
                    Cursor="SizeWestEast"/>

            <Border Name="ResizeRight"
                    Width="4"
                    Background="Transparent"
                    Canvas.Top="4" Canvas.Bottom="4" Canvas.Right="-4"
                    Cursor="SizeWestEast"/>
            
            <!-- Link Handle (Right side) -->
             <Border Name="LinkHandle"
                    Width="12" Height="12"
                    CornerRadius="6"
                    Background="{DynamicResource AccentBrush}"
                    BorderBrush="White"
                    BorderThickness="2"
                    Canvas.Right="-6" 
                    Canvas.Top="{Binding Height, Converter={StaticResource HalfConverter}}"
                    Cursor="Cross"
                    ToolTip.Tip="Drag to link"/>
        </Canvas>
    </Grid>
</UserControl>
